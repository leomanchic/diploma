# The repository default preserves unknown SHA artifact formats byte-for-byte.
# The explicitly listed source/text formats below keep the established LF rule.
# Captured process streams are immutable bytes, even when empty or mixed-EOL.
*.stdout -text
*.stderr -text
# Frozen SHA-256 inputs and Python source keep identical bytes on Windows.
*.py text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.sdf text eol=lf
*.html text eol=lf
*.patch text eol=lf
*.log text eol=lf
*.txt text eol=lf
# This published protocol is a byte-exact, SHA-pinned research artifact.
LOCALIZATION_RANGE_PROTOCOL.md binary
# A git-format patch contains a single-space context marker on blank lines.
px4/*.patch whitespace=-blank-at-eol
results/px4_flight/*/*.patch whitespace=-blank-at-eol
# Keep PX4 console logs byte-for-byte; the program emits trailing tabs/spaces.
results/px4_flight/*/*.log whitespace=-blank-at-eol
# The diagnostic protocol is also immutable and verified byte-for-byte.
LOCALIZATION_ERROR_ATTRIBUTION_PROTOCOL.md binary
# The robust-confirmation evaluation protocol is SHA-pinned before all new runs.
ROBUST_TRACK_CONFIRMATION_PROTOCOL.md binary
UNSEEN_MANOEUVRES_PROTOCOL.md binary

# S8 diagnostic protocol is frozen before computations.
HARMONIC_TRACKING_FAILURE_PROTOCOL.md binary
# Preserve the diagnostic delivery bytes across checkout platforms.
notebooks/harmonic_tracking_failure.ipynb text eol=lf
results/harmonic_tracking_failure/ideal_replays/*/*.jsonl text eol=lf
